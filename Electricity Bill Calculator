
#include <stdio.h>
int main() {
    int units;
    float bill;
    printf("Enter electricity units: ");
    scanf("%d", &units);
    if (units <= 100)
        bill = units * 2.5;
    else if (units <= 200)
        bill = 100 * 2.5 + (units - 100) * 4;
    else
        bill = 100 * 2.5 + 100 * 4 + (units - 200) * 6;
    printf("Electricity Bill = Rs. %.2f", bill);
    return 0;
}
